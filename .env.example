# Optional: enables live LLM calls. Without this, the PoC runs in deterministic simulation mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Current defaults for gpt-5.6-luna, configurable so the benchmark remains reproducible if pricing changes.
OPENAI_INPUT_USD_PER_MTOK=0.20
OPENAI_OUTPUT_USD_PER_MTOK=1.20

# Optional: enables live Jev / TypeSafe decisions. Without this, the third lane runs in deterministic simulation mode.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_INPUT_USD_PER_MTOK=0.042
TYPESAFE_TIMEOUT_SECONDS=20
JEV_CONFIDENCE_THRESHOLD=0.80
JEV_ESCALATION_PROBABILITY=0.50

# Open zero-shot control lane. Simulated keeps the default install lightweight.
ZERO_SHOT_MODE=simulated
ZERO_SHOT_MODEL=facebook/bart-large-mnli

# Optional real NiFi adapter. The first UI version uses the local deterministic NiFi emulator by default.
NIFI_MODE=emulated
NIFI_BASE_URL=https://localhost:8443/nifi-api
NIFI_USERNAME=admin
NIFI_PASSWORD=ChangeMeAeroNCR2026!
NIFI_VERIFY_TLS=false
